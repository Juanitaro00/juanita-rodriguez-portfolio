---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
	project: CollectionEntry<"projects">["data"];
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} — Juanita Rodríguez`} description={project.summary} hideHeader>
	<header class="case-hero" style={`--project-accent: ${project.accent}`}>
		<div class="container">
			<a class="back-link" href="/#proyectos">← Proyectos seleccionados</a>
			<p class="eyebrow">Case study · {project.year}</p>
			<h1>{project.title}</h1>
			<p class="summary">{project.summary}</p>
		</div>
	</header>
	<section class="project-facts" aria-label="Información del proyecto">
		<dl class="container">
			<div><dt>Rol</dt><dd>{project.role}</dd></div>
			<div><dt>Servicios</dt><dd>{project.services.join(", ")}</dd></div>
			<div><dt>Duración</dt><dd>{project.duration}</dd></div>
			<div><dt>Equipo</dt><dd>{project.team}</dd></div>
		</dl>
	</section>
	<article class="case-body container"><slot /></article>
</BaseLayout>

<style>
	.case-hero { padding-block: var(--space-5) var(--space-6); background: var(--project-accent); }
	.back-link { display: inline-block; margin-block-end: var(--space-5); font-size: var(--step--1); font-weight: 700; }
	h1 { max-width: 15ch; margin-block-end: var(--space-3); font-family: var(--font-display); font-size: var(--step-3); font-weight: 500; letter-spacing: -0.04em; }
	.summary { max-width: 42rem; margin: 0; font-size: var(--step-1); }
	.project-facts { padding-block: var(--space-4); border-bottom: 1px solid var(--color-line); }
	dl { display: grid; gap: var(--space-3); margin-block: 0; }
	dt { margin-block-end: 0.3rem; color: var(--color-muted); font-size: var(--step--1); font-weight: 700; text-transform: uppercase; }
	dd { margin: 0; }
	.case-body { max-width: 52rem; padding-block: var(--space-6); }
	.case-body :global(h2) { margin-block: var(--space-5) var(--space-2); font-family: var(--font-display); font-size: var(--step-2); font-weight: 500; }
	.case-body :global(h2:first-child) { margin-block-start: 0; }
	.case-body :global(h3) { margin-block: var(--space-4) var(--space-2); font-size: var(--step-1); }
	.case-body :global(p), .case-body :global(li) { color: #3f3f3a; }
	.case-body :global(blockquote) { margin: var(--space-4) 0; padding: var(--space-3); border-left: 0.3rem solid var(--color-accent); background: var(--color-surface); font-size: var(--step-1); }
	.case-body :global(blockquote p) { margin: 0; }
	@media (min-width: 48rem) { dl { grid-template-columns: repeat(4, 1fr); } }
</style>
