<section class="brand-hero" aria-labelledby="brand-hero-title" data-brand-hero>
	<div class="brand-hero__wash brand-hero__wash--one" aria-hidden="true"></div>
	<div class="brand-hero__wash brand-hero__wash--two" aria-hidden="true"></div>
	<div class="brand-hero__line brand-hero__line--one" aria-hidden="true"></div>
	<div class="brand-hero__line brand-hero__line--two" aria-hidden="true"></div>

	<div class="brand-hero__meta">
		<p class="brand-hero__name">Juanita Rodríguez</p>
		<p class="brand-hero__role">UX/UI Digital Design</p>
	</div>

	<h1 class="brand-hero__title" id="brand-hero-title">
		<span class="brand-hero__title-word brand-hero__title-word--porta">Port<span class="brand-hero__porta-a">a</span></span>
		<span class="brand-hero__title-word brand-hero__title-word--folio">Foli<span class="brand-hero__quiet-o">o</span></span>
	</h1>

	<div class="brand-hero__stage" aria-hidden="true">
		<div class="brand-hero__character" data-hero-character>
			<div class="brand-hero__character-shadow"></div>
			<img
				class="brand-hero__character-image"
				src="/images/hero/juanita-personaje-original.png"
				srcset="/images/hero/juanita-personaje-original.png 1024w"
				sizes="(max-width: 28rem) 78vw, (max-width: 48rem) 22rem, (max-width: 64rem) 28rem, 32rem"
				width="1024"
				height="1536"
				alt=""
				decoding="sync"
				fetchpriority="high"
			/>
		</div>

		<div class="brand-hero__butterfly" data-hero-butterfly>
			<svg class="brand-hero__butterfly-asset" viewBox="0 0 941 1193" focusable="false">
				<defs>
					<mask id="hero-butterfly-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="941" height="1193" style="mask-type: luminance">
						<image href="/images/hero/juanita-mariposa-mask.png" width="941" height="1193" />
					</mask>
				</defs>
				<image href="/images/hero/juanita-mariposa-color.png" width="941" height="1193" mask="url(#hero-butterfly-mask)" />
			</svg>
		</div>
	</div>

	<p class="brand-hero__statement">Diseño experiencias digitales claras, humanas y con intención.</p>
	<a class="brand-hero__scroll" href="#proyectos">
		<span>Ver proyectos</span>
		<span aria-hidden="true">↓</span>
	</a>
</section>

<script is:inline>
	(() => {
		const hero = document.querySelector("[data-brand-hero]");
		const character = hero?.querySelector("[data-hero-character]");
		const butterfly = hero?.querySelector("[data-hero-butterfly]");
		if (!hero || !character || !butterfly) return;

		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
		if (reducedMotion.matches) return;

		let pointerX = 0;
		let pointerY = 0;
		let targetX = 0;
		let targetY = 0;
		let velocityX = 0;
		let velocityY = 0;
		let visible = true;
		let frame;
		const startedAt = performance.now();

		const clamp = (minimum, value, maximum) => Math.min(maximum, Math.max(minimum, value));

		const handlePointer = (event) => {
			if (!finePointer.matches) return;
			const bounds = hero.getBoundingClientRect();
			targetX = clamp(-1, ((event.clientX - bounds.left) / bounds.width - 0.5) * 2, 1);
			targetY = clamp(-1, ((event.clientY - bounds.top) / bounds.height - 0.5) * 2, 1);
		};

		const resetPointer = () => {
			targetX = 0;
			targetY = 0;
		};

		const render = (time) => {
			if (!visible || document.hidden) {
				frame = undefined;
				return;
			}

			velocityX = (velocityX + (targetX - pointerX) * 0.045) * 0.82;
			velocityY = (velocityY + (targetY - pointerY) * 0.045) * 0.82;
			pointerX += velocityX;
			pointerY += velocityY;

			hero.style.setProperty("--character-x", `${(pointerX * 16).toFixed(2)}px`);
			hero.style.setProperty("--character-y", `${(pointerY * 9).toFixed(2)}px`);
			hero.style.setProperty("--character-rotate-x", `${(-pointerY * 1.7).toFixed(2)}deg`);
			hero.style.setProperty("--character-rotate-y", `${(pointerX * 2.4).toFixed(2)}deg`);
			hero.style.setProperty("--far-x", `${(-pointerX * 4).toFixed(2)}px`);
			hero.style.setProperty("--far-y", `${(-pointerY * 3).toFixed(2)}px`);

			const heroBounds = hero.getBoundingClientRect();
			const characterBounds = character.getBoundingClientRect();
			const elapsed = time - startedAt;
			const angle = (elapsed / 18000) * Math.PI * 2 + Math.PI * 1.25;
			const centerX = characterBounds.left - heroBounds.left + characterBounds.width * 0.56;
			const centerY = characterBounds.top - heroBounds.top + characterBounds.height * 0.29;
			const radiusX = characterBounds.width * 0.33;
			const radiusY = characterBounds.height * 0.16;
			let butterflyX = centerX + Math.cos(angle) * radiusX + Math.sin(angle * 2.1) * characterBounds.width * 0.025;
			let butterflyY = centerY + Math.sin(angle) * radiusY + Math.sin(angle * 1.7) * 4;

			const faceX = characterBounds.left - heroBounds.left + characterBounds.width * 0.56;
			const faceY = characterBounds.top - heroBounds.top + characterBounds.height * 0.14;
			const safeX = characterBounds.width * 0.2;
			const safeY = characterBounds.height * 0.105;
			const distanceX = butterflyX - faceX;
			const distanceY = butterflyY - faceY;
			const faceDistance = (distanceX * distanceX) / (safeX * safeX) + (distanceY * distanceY) / (safeY * safeY);

			if (faceDistance < 1) {
				const side = distanceX < 0 ? -1 : 1;
				const verticalRatio = clamp(-0.98, distanceY / safeY, 0.98);
				butterflyX = faceX + side * safeX * Math.sqrt(1 - verticalRatio * verticalRatio);
			}

			butterflyX += pointerX * 3;
			butterflyY += pointerY * 2;
			const rotation = Math.sin(angle * 1.4) * 4;

			hero.style.setProperty("--butterfly-x", `${butterflyX.toFixed(2)}px`);
			hero.style.setProperty("--butterfly-y", `${butterflyY.toFixed(2)}px`);
			hero.style.setProperty("--butterfly-rotate", `${rotation.toFixed(2)}deg`);

			frame = requestAnimationFrame(render);
		};

		const observer = new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			if (visible && !frame) frame = requestAnimationFrame(render);
		}, { threshold: 0.02 });

		hero.addEventListener("pointermove", handlePointer, { passive: true });
		hero.addEventListener("pointerleave", resetPointer, { passive: true });
		document.addEventListener("visibilitychange", () => {
			if (!document.hidden && visible && !frame) frame = requestAnimationFrame(render);
		});
		observer.observe(hero);
		frame = requestAnimationFrame(render);
	})();
</script>

