---
const pages = Array.from({ length: 13 }, (_, index) => ({
	src: `/images/projects/clara-vision/page-${index + 1}.webp`,
	alt: index === 0
		? "Portada del manual de marca ClaraVisión"
		: `Página ${index + 1} del manual de marca ClaraVisión`,
}));
---

<article id="proyecto-clara-vision" class="clara-case" data-claravision-case>
	<div class="clara-case__copy">
		<p class="clara-case__number" aria-label="Proyecto 06">06</p>
		<h3>ClaraVisión, Ver con claridad</h3>
		<p class="clara-case__discipline">Identidad visual · Branding · Sistema de marca</p>
		<p class="clara-case__description">Una identidad médica dedicada al cuidado de la salud visual desde una atención cercana, rigurosa y profundamente humana. El sistema une claridad, precisión y confianza para acompañar a cada paciente con cuidado y compromiso.</p>
		<button class="clara-case__cta" type="button" data-claravision-open>
			Ver proyecto <span aria-hidden="true">→</span>
		</button>
	</div>

	<button class="clara-preview" type="button" data-claravision-open aria-label="Abrir el manual interactivo de ClaraVisión">
		<span class="clara-preview__glow" aria-hidden="true"></span>
		<span class="clara-preview__spread clara-preview__spread--back" aria-hidden="true">
			<img src="/images/projects/clara-vision/page-13.webp" alt="" width="1600" height="1130" loading="lazy" />
		</span>
		<span class="clara-preview__spread clara-preview__spread--front" aria-hidden="true">
			<img src="/images/projects/clara-vision/page-6.webp" alt="" width="1600" height="1130" loading="lazy" />
		</span>
		<span class="clara-preview__cover">
			<img src="/images/projects/clara-vision/cover-book-cutout.png" alt="Mockup del manual de marca ClaraVisión" width="1450" height="1085" loading="lazy" />
		</span>
	</button>

	<dialog class="clara-viewer" data-claravision-dialog aria-labelledby="claravision-viewer-title">
		<div class="clara-viewer__shell">
			<header class="clara-viewer__header">
				<div>
					<p>Manual de marca</p>
					<h3 id="claravision-viewer-title">ClaraVisión</h3>
				</div>
				<button class="clara-viewer__close" type="button" data-claravision-close aria-label="Cerrar el manual">
					<span>Cerrar</span><b aria-hidden="true">×</b>
				</button>
			</header>

			<div class="clara-book-stage" data-book-stage data-state="closed">
				<div class="clara-book" data-book>
					<div class="clara-book__base" aria-hidden="true"></div>
					<img
						class="clara-book__spread"
						data-book-image
						src={pages[0].src}
						alt={pages[0].alt}
						width="1600"
						height="1130"
					/>
					<div class="clara-book__old-half" data-book-old-half aria-hidden="true"></div>
					<div class="clara-book__turn" data-book-turn aria-hidden="true">
						<div class="clara-book__turn-face clara-book__turn-face--front"></div>
						<div class="clara-book__turn-face clara-book__turn-face--back"></div>
					</div>
					<div class="clara-book__spine" aria-hidden="true"></div>
					<div class="clara-book__cover" data-book-cover aria-hidden="true">
						<img src="/images/projects/clara-vision/page-1.webp" alt="" width="1600" height="1130" />
					</div>
				</div>
				<p class="clara-book__status" data-book-status role="status" aria-live="polite"></p>
			</div>

			<footer class="clara-viewer__controls">
				<button type="button" data-book-prev aria-keyshortcuts="ArrowLeft">Anterior</button>
				<p><span data-book-current>01</span><span aria-hidden="true"> / </span><span class="sr-only">de</span><span>13</span></p>
				<button type="button" data-book-next aria-keyshortcuts="ArrowRight">Siguiente</button>
			</footer>
		</div>
	</dialog>
</article>

<script>
	import { registerProjectDeepLink } from "../../scripts/projectDeepLinks";

	const pages = Array.from({ length: 13 }, (_, index) => ({
		src: `/images/projects/clara-vision/page-${index + 1}.webp`,
		alt: index === 0
			? "Portada del manual de marca ClaraVisión"
			: `Página ${index + 1} del manual de marca ClaraVisión`,
	}));

	document.querySelectorAll<HTMLElement>("[data-claravision-case]").forEach((caseStudy) => {
		const dialog = caseStudy.querySelector<HTMLDialogElement>("[data-claravision-dialog]");
		const openButtons = caseStudy.querySelectorAll<HTMLButtonElement>("[data-claravision-open]");
		const closeButton = caseStudy.querySelector<HTMLButtonElement>("[data-claravision-close]");
		const stage = caseStudy.querySelector<HTMLElement>("[data-book-stage]");
		const book = caseStudy.querySelector<HTMLElement>("[data-book]");
		const image = caseStudy.querySelector<HTMLImageElement>("[data-book-image]");
		const previousButton = caseStudy.querySelector<HTMLButtonElement>("[data-book-prev]");
		const nextButton = caseStudy.querySelector<HTMLButtonElement>("[data-book-next]");
		const currentLabel = caseStudy.querySelector<HTMLElement>("[data-book-current]");
		const status = caseStudy.querySelector<HTMLElement>("[data-book-status]");
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		if (!dialog || !stage || !book || !image || !previousButton || !nextButton || !currentLabel || !status) return;

		let currentIndex = 0;
		let isTurning = false;
		let openingTimer = 0;
		let lastFocused: HTMLElement | null = null;
		const bookRatio = 1600 / 1130;
		const pageTurnDuration = 720;

		const fitBook = () => {
			const stageWidth = stage.clientWidth;
			const stageHeight = stage.clientHeight;
			if (!stageWidth || !stageHeight) return;

			const edgeSpace = Math.max(12, Math.min(32, stageWidth * 0.025));
			const availableWidth = Math.max(240, stageWidth - edgeSpace * 2);
			const availableHeight = Math.max(180, stageHeight - 88);
			const fittedWidth = Math.min(availableWidth, availableHeight * bookRatio);
			const fittedHeight = fittedWidth / bookRatio;

			book.style.width = `${fittedWidth}px`;
			book.style.height = `${fittedHeight}px`;
		};

		const bookResizeObserver = new ResizeObserver(fitBook);
		bookResizeObserver.observe(stage);

		const updateControls = () => {
			previousButton.disabled = currentIndex === 0 || isTurning;
			nextButton.disabled = currentIndex === pages.length - 1 || isTurning;
			currentLabel.textContent = String(currentIndex + 1).padStart(2, "0");
		};

		const loadPage = (index: number) => new Promise<void>((resolve, reject) => {
			const preloader = new Image();
			preloader.onload = () => resolve();
			preloader.onerror = () => reject(new Error("No se pudo cargar esta página."));
			preloader.src = pages[index].src;
		});

		const preloadBook = () => {
			pages.forEach((page) => {
				const preloader = new Image();
				preloader.src = page.src;
			});
		};

		const showPage = async (targetIndex: number, direction: "next" | "previous") => {
			if (isTurning || targetIndex < 0 || targetIndex >= pages.length || targetIndex === currentIndex) return;
			isTurning = true;
			status.textContent = "Cargando página";
			updateControls();

			try {
				await loadPage(targetIndex);
				const oldPage = pages[currentIndex];
				const newPage = pages[targetIndex];
				book.style.setProperty("--page-from", `url("${oldPage.src}")`);
				book.style.setProperty("--page-to", `url("${newPage.src}")`);
				image.src = newPage.src;
				image.alt = newPage.alt;
				currentIndex = targetIndex;
				currentLabel.textContent = String(currentIndex + 1).padStart(2, "0");

				if (reduceMotion.matches) {
					isTurning = false;
					status.textContent = `Página ${currentIndex + 1} de ${pages.length}`;
					updateControls();
					return;
				}

				book.dataset.direction = direction;
				book.classList.remove("is-turning");
				window.requestAnimationFrame(() => {
					window.requestAnimationFrame(() => book.classList.add("is-turning"));
				});

				window.setTimeout(() => {
					book.classList.remove("is-turning");
					delete book.dataset.direction;
					isTurning = false;
					status.textContent = `Página ${currentIndex + 1} de ${pages.length}`;
					updateControls();
				}, pageTurnDuration);
			} catch (error) {
				isTurning = false;
				status.textContent = error instanceof Error ? error.message : "No se pudo cargar esta página.";
				updateControls();
			}
		};

		const openBook = () => {
			if (dialog.open) return;
			lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			dialog.showModal();
			document.documentElement.classList.add("has-open-dialog");
			stage.dataset.state = "closed";
			currentIndex = 1;
			image.src = pages[1].src;
			image.alt = pages[1].alt;
			status.textContent = "Abriendo el manual";
			updateControls();
			fitBook();

			window.clearTimeout(openingTimer);
			window.requestAnimationFrame(() => {
				fitBook();
				stage.dataset.state = reduceMotion.matches ? "open" : "opening";
				closeButton?.focus({ preventScroll: true });
			});
			openingTimer = window.setTimeout(() => {
				stage.dataset.state = "open";
				status.textContent = `Página 2 de ${pages.length}`;
			}, reduceMotion.matches ? 0 : 850);
			window.setTimeout(preloadBook, 120);
		};

		const closeBook = () => {
			window.clearTimeout(openingTimer);
			if (dialog.open) dialog.close();
		};

		const projectDeepLink = registerProjectDeepLink("claravision", {
			open: openBook,
			close: closeBook,
			isOpen: () => dialog.open,
		});

		openButtons.forEach((button) => button.addEventListener("click", projectDeepLink.openProject));
		closeButton?.addEventListener("click", projectDeepLink.closeProject);
		previousButton.addEventListener("click", () => showPage(currentIndex - 1, "previous"));
		nextButton.addEventListener("click", () => showPage(currentIndex + 1, "next"));

		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) projectDeepLink.closeProject();
		});

		dialog.addEventListener("cancel", (event) => {
			event.preventDefault();
			projectDeepLink.closeProject();
		});

		dialog.addEventListener("keydown", (event) => {
			if (event.repeat || (event.key !== "ArrowLeft" && event.key !== "ArrowRight")) return;
			event.preventDefault();
			if (event.key === "ArrowLeft") showPage(currentIndex - 1, "previous");
			if (event.key === "ArrowRight") showPage(currentIndex + 1, "next");
		});

		dialog.addEventListener("close", () => {
			document.documentElement.classList.remove("has-open-dialog");
			stage.dataset.state = "closed";
			status.textContent = "";
			lastFocused?.focus();
		});
	});
</script>

<style>
	:global(html.has-open-dialog) { overflow: hidden; }

	.clara-case {
		--clara-navy: #012450;
		--clara-teal: #3f808a;
		--clara-sky: #7db2c1;
		--clara-blue: #71a2ca;
		--clara-pale: #c1dcf2;
		position: relative;
		display: grid;
		isolation: isolate;
		gap: clamp(2rem, 5vw, 5rem);
		padding: clamp(2rem, 5vw, 4.5rem);
		overflow: visible;
		border: 1px solid rgb(255 255 255 / 0.85);
		border-radius: clamp(1.5rem, 3vw, 2.75rem);
		background:
			radial-gradient(circle at 86% 12%, rgb(125 178 193 / 0.27), transparent 26%),
			radial-gradient(circle at 18% 92%, rgb(113 162 202 / 0.16), transparent 31%),
			linear-gradient(135deg, rgb(252 254 255 / 0.98), rgb(225 240 246 / 0.94));
		box-shadow: 0 1.5rem 4rem rgb(1 36 80 / 0.12), inset 0 1px 0 rgb(255 255 255 / 0.96);
	}

	.clara-case::after {
		position: absolute;
		right: -8rem;
		bottom: -10rem;
		z-index: -1;
		width: 24rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: rgb(63 128 138 / 0.12);
		content: "";
	}

	.clara-case__copy {
		align-self: center;
		max-width: 37rem;
	}

	.clara-case__number {
		margin: 0 0 1rem;
		color: var(--clara-teal);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		line-height: 1.2;
	}

	.clara-case h3 {
		max-width: none;
		margin: 0 0 var(--space-1);
		color: var(--clara-navy);
		font-family: var(--font-sans);
		font-size: clamp(1.65rem, 3vw, 2.7rem);
		font-weight: 800;
		letter-spacing: -0.025em;
		line-height: 1.08;
		text-transform: uppercase;
	}

	.clara-case__discipline {
		margin: 0 0 var(--space-1);
		color: var(--clara-teal);
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: normal;
		line-height: inherit;
		text-transform: none;
	}

	.clara-case__description {
		max-width: var(--measure);
		margin: 0;
		color: #31566a;
		font-size: clamp(1rem, 1.25vw, 1.12rem);
		line-height: 1.6;
	}

	.clara-case__cta {
		display: inline-block;
		margin-block-start: clamp(1rem, 2vw, 1.75rem);
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--clara-navy);
		font: inherit;
		font-size: var(--step--1);
		font-weight: 700;
		line-height: 1.2;
		cursor: pointer;
		transition: color 0.25s ease, transform 0.25s ease;
	}

	.clara-case__cta span { display: inline-block; margin-left: 0.35rem; transition: transform 0.25s ease; }
	.clara-case__cta:hover { color: var(--clara-teal); }
	.clara-case__cta:hover span { transform: translateX(0.25rem); }
	.clara-case__cta:active { transform: translateY(1px); }

	.clara-case__credits {
		display: grid;
		gap: 0.18rem;
		margin-block-start: clamp(0.9rem, 1.5vw, 1.25rem);
		color: #4e6e7e;
		font-size: clamp(0.72rem, 0.85vw, 0.82rem);
		line-height: 1.45;
	}

	.clara-case__credits span {
		color: var(--clara-teal);
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.clara-case__credits p { margin: 0; }

	.clara-preview {
		position: relative;
		min-width: 0;
		min-height: clamp(27rem, 52vw, 42rem);
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
		perspective: 100rem;
	}

	.clara-preview__glow {
		position: absolute;
		inset: 13% 4% 7% 8%;
		border-radius: 50%;
		background: rgb(125 178 193 / 0.28);
		filter: blur(3.5rem);
	}

	.clara-preview__spread,
	.clara-preview__cover {
		position: absolute;
		display: block;
		overflow: hidden;
		border-radius: clamp(0.5rem, 1vw, 0.9rem);
		box-shadow: 0 1.5rem 3.6rem rgb(1 36 80 / 0.2);
		transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.65s ease;
	}

	.clara-preview__spread img,
	.clara-preview__cover img { width: 100%; height: 100%; object-fit: cover; }

	.clara-preview__spread--back {
		top: 1%;
		right: -3%;
		width: 72%;
		aspect-ratio: 1600 / 1130;
		transform: rotate(5deg) translateZ(-2rem);
	}

	.clara-preview__spread--front {
		top: 26%;
		left: -5%;
		width: 73%;
		aspect-ratio: 1600 / 1130;
		transform: rotate(-6deg) translateZ(-1rem);
	}

	.clara-preview__cover {
		right: -3%;
		bottom: 1%;
		z-index: 3;
		width: 83%;
		aspect-ratio: 4 / 3;
		overflow: visible;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		transform: rotate(-1.4deg) translateZ(1rem);
	}

	.clara-preview__cover img {
		display: block;
		border-radius: 0;
		object-fit: cover;
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.clara-preview:hover .clara-preview__spread--back { transform: rotate(8deg) translate(0.65rem, -0.65rem) translateZ(-2rem); }
		.clara-preview:hover .clara-preview__spread--front { transform: rotate(-9deg) translate(-0.9rem, -0.45rem) translateZ(-1rem); }
		.clara-preview:hover .clara-preview__cover { transform: rotate(-0.35deg) translate(0.25rem, -0.7rem) translateZ(1rem); }
	}

	.clara-viewer {
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: #e6f2f7;
		color: var(--clara-navy);
		box-shadow: none;
	}

	.clara-viewer::backdrop {
		background: rgb(1 24 52 / 0.76);
		-webkit-backdrop-filter: blur(0.6rem);
		backdrop-filter: blur(0.6rem);
	}

	.clara-viewer__shell {
		position: relative;
		height: 100%;
		padding: 0;
	}

	.clara-viewer__header,
	.clara-viewer__controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.clara-viewer__header {
		position: absolute;
		top: clamp(1rem, 2.2vw, 2rem);
		right: clamp(1rem, 2.2vw, 2rem);
		left: clamp(1rem, 2.2vw, 2rem);
		z-index: 20;
		pointer-events: none;
	}
	.clara-viewer__header > * { pointer-events: auto; }
	.clara-viewer__header p { margin: 0 0 0.1rem; color: var(--clara-teal); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
	.clara-viewer__header h3 { max-width: none; margin: 0; font-family: var(--font-sans); font-size: clamp(1.2rem, 2vw, 1.7rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; }

	.clara-viewer__close,
	.clara-viewer__controls button {
		border: 1px solid rgb(1 36 80 / 0.2);
		background: rgb(255 255 255 / 0.84);
		color: var(--clara-navy);
		font-size: 0.88rem;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
		-webkit-backdrop-filter: blur(0.8rem);
		backdrop-filter: blur(0.8rem);
	}

	.clara-viewer__close { display: flex; align-items: center; gap: 0.65rem; padding: 0.5rem 0.75rem 0.5rem 0.9rem; border-radius: 999px; }
	.clara-viewer__close b { font-size: 1.4rem; font-weight: 400; line-height: 0.8; }
	.clara-viewer__close:hover,
	.clara-viewer__controls button:hover { background: #fff; }
	.clara-viewer__close:active,
	.clara-viewer__controls button:active { transform: translateY(1px); }

	.clara-book-stage {
		position: relative;
		display: grid;
		width: 100%;
		height: 100%;
		min-height: 0;
		place-items: center;
		overflow: hidden;
		background:
			radial-gradient(ellipse 58% 66% at 50% 44%, rgb(255 255 255 / 0.98), transparent 72%),
			radial-gradient(circle at 86% 14%, rgb(125 178 193 / 0.25), transparent 27%),
			linear-gradient(145deg, #edf7fa, #c9e3ec);
		perspective: 120rem;
	}

	.clara-book {
		--page-from: url("/images/projects/clara-vision/page-1.webp");
		--page-to: url("/images/projects/clara-vision/page-2.webp");
		position: relative;
		width: min(86%, 76rem);
		aspect-ratio: 1600 / 1130;
		transform-style: preserve-3d;
		transform: rotateX(1.2deg);
		filter: drop-shadow(0 2.2rem 2.4rem rgb(1 36 80 / 0.2));
	}

	.clara-book::before {
		position: absolute;
		inset: -0.4% -0.5% -0.7%;
		z-index: 2;
		border: 1px solid rgb(255 255 255 / 0.72);
		border-radius: 0.5rem;
		box-shadow: inset 0 0 0 1px rgb(1 36 80 / 0.07);
		content: "";
		pointer-events: none;
		transform: translateZ(0.08rem);
	}

	.clara-book__base {
		position: absolute;
		inset: -0.7% -0.9% -2.1%;
		border-radius: 0.6rem;
		background-color: #edf6fa;
		background-image: linear-gradient(
			90deg,
			transparent 24%,
			rgb(125 178 193 / 0.55) 24.15%,
			transparent 24.3%,
			transparent 49.85%,
			rgb(125 178 193 / 0.55) 50%,
			transparent 50.15%,
			transparent 74.7%,
			rgb(125 178 193 / 0.55) 74.85%,
			transparent 75%
		);
		box-shadow:
			0 0.5rem 0 #d7eaf1,
			0 0.76rem 0 var(--clara-navy),
			0 1.4rem 2.2rem rgb(1 36 80 / 0.18);
		transform: translateZ(-0.5rem);
	}

	.clara-book__spread,
	.clara-book__cover {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border-radius: 0.35rem;
		object-fit: cover;
		background: #e8f3f7;
		box-shadow: inset 0 0 0 1px rgb(1 36 80 / 0.05);
	}

	.clara-book__cover {
		z-index: 5;
		overflow: hidden;
		transform-origin: left center;
		transition: transform 0.82s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.32s 0.48s ease;
	}

	.clara-book__cover img { width: 100%; height: 100%; object-fit: cover; }
	[data-state="opening"] .clara-book__cover,
	[data-state="open"] .clara-book__cover { opacity: 0; transform: rotateY(-112deg); pointer-events: none; }

	.clara-book__spine {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		z-index: 7;
		width: 1.15%;
		background: linear-gradient(90deg, rgb(1 36 80 / 0.12), rgb(255 255 255 / 0.56), rgb(1 36 80 / 0.14));
		box-shadow: 0 0 1.2rem rgb(1 36 80 / 0.15);
		transform: translateX(-50%) translateZ(0.2rem);
		pointer-events: none;
	}

	.clara-book__old-half,
	.clara-book__turn {
