<script>
	const caseStudy = document.querySelector<HTMLElement>("[data-case-study]");
	const activateTabs = (root: HTMLElement, tabSelector: string, panelSelector: string, tabKey: string, panelKey: string, onChange?: (id: string) => void) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>(tabSelector)];
		const panels = [...root.querySelectorAll<HTMLElement>(panelSelector)];
		if (!tabs.length || !panels.length) return;
		const select = (id: string, focus = false) => {
			tabs.forEach((tab) => { const active = tab.dataset[tabKey] === id; tab.setAttribute("aria-selected", String(active)); tab.tabIndex = active ? 0 : -1; if (active && focus) tab.focus(); });
			panels.forEach((panel) => panel.hidden = panel.dataset[panelKey] !== id);
			onChange?.(id);
		};
		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => select(tab.dataset[tabKey] ?? ""));
			tab.addEventListener("keydown", (event) => {
				if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
				event.preventDefault();
				let next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : index + (event.key === "ArrowRight" ? 1 : -1);
				next = (next + tabs.length) % tabs.length;
				select(tabs[next].dataset[tabKey] ?? "", true);
			});
		});
		return select;
	};
	if (caseStudy) {
		const selectPhase = activateTabs(caseStudy, "[data-phase-tab]", "[data-phase-panel]", "phaseTab", "phasePanel", (id) => history.replaceState(null, "", `#${id}`));
		activateTabs(caseStudy, "[data-product-tab]", "[data-product-panel]", "productTab", "productPanel");
		const requested = location.hash.slice(1);
		if (selectPhase && ["empatizar", "definir", "idear", "prototipar", "validar"].includes(requested)) selectPhase(requested);
	}
</script>
