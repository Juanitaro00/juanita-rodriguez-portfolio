---
const pathname = Astro.url.pathname;

interface Props {
	theme?: "default" | "regioo" | "tailors" | "four-twenty-one";
}

const { theme = "default" } = Astro.props;

const routeTheme = pathname.startsWith("/proyectos/regioo")
	? "regioo"
	: pathname.startsWith("/proyectos/tailors-shop")
		? "tailors"
		: pathname.startsWith("/proyectos/421-co")
			? "four-twenty-one"
		: "default";
const resolvedTheme = theme === "default" ? routeTheme : theme;

const links = [
	{ href: "/#proyectos", label: "Trabajo" },
	{ href: "/#sobre-mi", label: "Sobre mí" },
	{ href: "/#contacto", label: "Contacto" },
];

const isCurrent = (href: string) => {
	if (href.startsWith("/#")) return false;
	return href === "/" ? pathname === href : pathname.startsWith(href);
};
---

<header class:list={["site-header", `site-header--${resolvedTheme}`]} data-theme={resolvedTheme}>
	<div class="container header-inner">
		<nav aria-label="Navegación principal">
			<ul>
				{
					links.map((link) => (
						<li>
							<a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		border-bottom: 1px solid rgb(255 255 255 / 0.72);
		background: rgb(255 250 252 / 0.36);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.82),
			0 0.75rem 2.5rem rgb(96 8 34 / 0.055);
		-webkit-backdrop-filter: saturate(145%) blur(20px);
		backdrop-filter: saturate(145%) blur(20px);
	}

	.site-header::before {
		position: absolute;
		inset: -165% -12%;
		z-index: 0;
		background:
			radial-gradient(circle at 18% 50%, rgb(251 220 229 / 0.82) 0 13%, transparent 34%),
			radial-gradient(circle at 70% 46%, rgb(247 190 206 / 0.64) 0 14%, transparent 36%),
			radial-gradient(circle at 49% 56%, rgb(96 8 34 / 0.045) 0 8%, transparent 30%);
		filter: blur(34px);
		content: "";
		animation: header-color-drift 14s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
	}

	.site-header::after {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(110deg, rgb(255 255 255 / 0.62), rgb(255 248 251 / 0.2) 46%, rgb(255 255 255 / 0.46)),
			linear-gradient(180deg, rgb(255 255 255 / 0.3), transparent 60%);
		box-shadow: inset 0 -1px 0 rgb(96 8 34 / 0.055);
		content: "";
		pointer-events: none;
	}

	.site-header--regioo {
		border-bottom-color: rgb(8 127 140 / 0.16);
		background: rgb(213 244 240 / 0.76);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.86),
			0 0.75rem 2.5rem rgb(8 127 140 / 0.11);
	}

	.site-header--regioo::before {
		background:
			radial-gradient(circle at 18% 50%, rgb(183 235 226 / 0.96) 0 15%, transparent 38%),
			radial-gradient(circle at 70% 46%, rgb(105 200 187 / 0.82) 0 16%, transparent 40%),
			radial-gradient(circle at 49% 56%, rgb(8 127 140 / 0.18) 0 10%, transparent 34%);
	}

	.site-header--regioo::after {
		background:
			linear-gradient(110deg, rgb(255 255 255 / 0.36), rgb(222 249 246 / 0.12) 46%, rgb(255 255 255 / 0.26)),
			linear-gradient(180deg, rgb(255 255 255 / 0.2), transparent 60%);
		box-shadow: inset 0 -1px 0 rgb(8 127 140 / 0.07);
	}

	.site-header--tailors {
		border-bottom-color: rgb(59 61 187 / 0.16);
		background: rgb(232 226 255 / 0.76);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.86),
			0 0.75rem 2.5rem rgb(59 61 187 / 0.11);
	}

	.site-header--tailors::before {
		background:
			radial-gradient(circle at 18% 50%, rgb(211 202 255 / 0.96) 0 15%, transparent 38%),
			radial-gradient(circle at 70% 46%, rgb(157 143 232 / 0.84) 0 16%, transparent 40%),
			radial-gradient(circle at 49% 56%, rgb(59 61 187 / 0.18) 0 10%, transparent 34%);
	}

	.site-header--tailors::after {
		background:
			linear-gradient(110deg, rgb(255 255 255 / 0.36), rgb(239 235 255 / 0.12) 46%, rgb(255 255 255 / 0.26)),
			linear-gradient(180deg, rgb(255 255 255 / 0.2), transparent 60%);
		box-shadow: inset 0 -1px 0 rgb(59 61 187 / 0.07);
	}

	.site-header--four-twenty-one {
		border-bottom-color: rgb(24 39 92 / 0.12);
		background: #fdfdfe;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.9),
			0 0.75rem 2.5rem rgb(24 39 92 / 0.06);
	}

	.site-header--four-twenty-one::before {
		background:
			radial-gradient(circle at 18% 50%, rgb(255 208 80 / 0.12) 0 14%, transparent 36%),
			radial-gradient(circle at 70% 46%, rgb(199 190 220 / 0.48) 0 16%, transparent 40%),
			radial-gradient(circle at 49% 56%, rgb(24 39 92 / 0.05) 0 9%, transparent 32%);
	}

	.site-header--four-twenty-one::after {
		background:
			linear-gradient(110deg, rgb(255 255 255 / 0.58), rgb(247 246 251 / 0.14) 46%, rgb(255 255 255 / 0.4)),
			linear-gradient(180deg, rgb(255 255 255 / 0.28), transparent 60%);
		box-shadow: inset 0 -1px 0 rgb(24 39 92 / 0.05);
	}

	.header-inner {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		min-height: 5rem;
	}

	nav { margin-left: auto; }

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(0.75rem, 2vw, 2rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		color: #32131d;
		font-size: var(--step--1);
		font-weight: 700;
		text-decoration: none;
		transition: color 240ms ease;
	}

	nav a::after {
		position: absolute;
		right: 0;
		bottom: 0.3rem;
		left: 0;
		height: 1px;
		background: linear-gradient(90deg, #d58a9c, #600822);
		transform: scaleX(0);
		transform-origin: right center;
		content: "";
		transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	nav a:hover,
	nav a[aria-current="page"] {
		color: #600822;
	}

	.site-header--regioo nav a { color:#174b51; }
	.site-header--regioo nav a::after { background:linear-gradient(90deg,#71c9c2,#087f8c); }
	.site-header--regioo nav a:hover,
	.site-header--regioo nav a[aria-current="page"] { color:#075d68; }

	.site-header--tailors nav a { color:#292c84; }
	.site-header--tailors nav a::after { background:linear-gradient(90deg,#aaa0ee,#3b3dbb); }
	.site-header--tailors nav a:hover,
	.site-header--tailors nav a[aria-current="page"] { color:#292c84; }

	.site-header--four-twenty-one nav a { color:#18275c; }
	.site-header--four-twenty-one nav a::after { background:linear-gradient(90deg,#c7bedc,#18275c); }
	.site-header--four-twenty-one nav a:hover,
	.site-header--four-twenty-one nav a[aria-current="page"] { color:#18275c; }

	nav a:hover::after,
	nav a[aria-current="page"]::after {
		transform: scaleX(1);
		transform-origin: left center;
	}

	@keyframes header-color-drift {
		0% { transform: translate3d(-4%, -1%, 0) scale(1); opacity: 0.72; }
		50% { transform: translate3d(3%, 1%, 0) scale(1.035); opacity: 0.9; }
		100% { transform: translate3d(7%, -1%, 0) scale(1.01); opacity: 0.76; }
	}

	@media (max-width: 32rem) {
		.header-inner {
			align-items: flex-start;
			flex-direction: column;
			padding-block: 1rem;
		}

		nav { margin-left: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header::before { animation: none; transform: none; }
		nav a,
		nav a::after { transition: none; }
	}
</style>
