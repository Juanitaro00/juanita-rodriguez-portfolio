---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const portfolioProjectIds = new Set(["tailors-shop", "regioo", "421-co"]);
const projects = (await getCollection("projects"))
	.filter((project) => portfolioProjectIds.has(project.id))
	.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Proyectos — Juanita Rodríguez" description="Selección de proyectos de UX/UI, diseño visual y front-end.">
	<header class="page-header container">
		<p class="eyebrow">Archivo de trabajo</p>
		<h1>Proyectos seleccionados</h1>
		<p>Una mirada al contexto, el proceso y las decisiones detrás de cada resultado.</p>
	</header>
	<section class="container project-grid" aria-label="Lista de proyectos">
		{projects.map((project, index) => (
			<a class="project-card" href={`/proyectos/${project.id}/`} target="_blank" rel="noreferrer" style={`--card-accent: ${project.data.accent}`}>
				<div class="project-visual" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></div>
				<div><p>{project.data.services.join(" · ")}</p><h2>{project.data.title}</h2><span>{project.data.summary}</span></div>
			</a>
		))}
	</section>
</BaseLayout>

<style>
	.page-header { padding-block: var(--space-6) var(--space-5); }
	h1 { max-width: 12ch; margin-block-end: var(--space-3); font-family: var(--font-display); font-size: var(--step-3); font-weight: 500; letter-spacing: -0.04em; }
	.page-header > p:last-child { max-width: 40rem; color: var(--color-muted); font-size: var(--step-1); }
	.project-grid { display: grid; gap: var(--space-5); padding-block-end: var(--space-6); }
	.project-card { display: grid; gap: var(--space-3); color: inherit; text-decoration: none; }
	.project-visual { display: grid; aspect-ratio: 4 / 3; place-items: center; border-radius: var(--radius-medium); background: var(--card-accent); color: var(--color-accent); font-family: var(--font-display); font-size: var(--step-3); transition: transform 180ms ease; }
	.project-card:hover .project-visual { transform: translateY(-0.25rem); }
	.project-card p { margin-block-end: var(--space-1); color: var(--color-accent); font-size: var(--step--1); font-weight: 700; }
	.project-card h2 { margin-block-end: var(--space-1); font-size: var(--step-1); }
	.project-card div > span { color: var(--color-muted); }
	@media (min-width: 48rem) { .project-grid { grid-template-columns: repeat(2, 1fr); } .project-card:first-child { grid-column: 1 / -1; } .project-card:first-child .project-visual { aspect-ratio: 2 / 1; } }
</style>
