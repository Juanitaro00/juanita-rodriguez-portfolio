---
import { getCollection } from "astro:content";
import HeroPortfolio from "../components/home/HeroPortfolio.astro";
import ArepaMiaShowcase from "../components/projects/ArepaMiaShowcase.astro";
import ClaraVisionShowcase from "../components/projects/ClaraVisionShowcase.astro";
import GenerativeMediaGallery from "../components/projects/GenerativeMediaGallery.astro";
import PandaChaShowcase from "../components/projects/PandaChaShowcase.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => data.featured))
	.filter((project) => project.id !== "ecommerce")
	.sort((a, b) => a.data.order - b.data.order);

const fourTwentyOneViews = [
	{ desktop: "/images/projects/421-co/home-desktop.png", mobile: "/images/projects/421-co/home-mobile.png", name: "Home" },
	{ desktop: "/images/projects/421-co/products-selected-desktop.png", mobile: "/images/projects/421-co/products-selected-mobile.png", name: "Productos" },
	{ desktop: "/images/projects/421-co/contact-selected-desktop.png", mobile: "/images/projects/421-co/contact-selected-mobile.png", name: "Contacto" },
	{ desktop: "/images/projects/421-co/404-selected-desktop.png", mobile: "/images/projects/421-co/404-selected-mobile.png", name: "Error 404" },
];
---

<BaseLayout
	title="Juanita Rodríguez — UX/UI Digital Design"
	description="Portafolio de Juanita Rodríguez: UX/UI, identidad visual, front-end e inteligencia artificial generativa."
>
	<HeroPortfolio />

	<section class="about-resume" id="sobre-mi" aria-labelledby="about-resume-title">
		<div class="container about-resume__inner">
			<div class="about-resume__hero">
				<div class="about-resume__identity">
					<p class="about-resume__eyebrow">Sobre mí</p>
					<h2 id="about-resume-title"><span>Juanita</span><span>Rodríguez</span></h2>
					<p class="about-resume__role">UX/UI Designer <span aria-hidden="true">·</span> Diseño centrado en las personas</p>
					<p class="about-resume__statement">
						Soy Juanita Rodríguez, diseñadora digital enfocada en UX/UI.<br />
						Me gusta entender a las personas, descubrir lo que necesitan y transformar esas ideas en experiencias claras, útiles y visualmente cuidadas.
					</p>
				</div>

				<div class="about-resume__portrait">
					<svg class="about-resume__clip-def" aria-hidden="true" focusable="false">
						<defs>
							<clipPath id="about-portrait-clip" clipPathUnits="objectBoundingBox">
								<path d="M .5 0 C .78 0 1 .22 1 .5 C 1 .78 .78 1 .5 1 C .22 1 .075 .78 .075 .5 C .075 .22 .22 0 .5 0 Z"></path>
							</clipPath>
						</defs>
					</svg>
					<div class="about-resume__halo" aria-hidden="true" data-about-orb></div>
					<div class="about-resume__photo-shell">
						<img
							src="/images/about/juanita-retrato.jpeg"
							width="768"
							height="1024"
							alt="Retrato de Juanita Rodríguez"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>

			<div class="about-resume__grid">
				<section class="about-resume__group about-resume__group--specialty" aria-labelledby="about-focus-title">
					<p class="about-resume__index" aria-hidden="true">01</p>
					<h3 id="about-focus-title">Enfoque UX/UI</h3>
					<ul>
						<li>UX Research</li>
						<li>Information Architecture</li>
						<li>Interaction Design</li>
						<li>UI Design</li>
						<li>Prototyping</li>
						<li>Design Systems</li>
					</ul>
				</section>

				<section class="about-resume__group about-resume__group--tools" aria-labelledby="about-tools-title">
					<p class="about-resume__index" aria-hidden="true">02</p>
					<h3 id="about-tools-title">Herramientas</h3>
					<ul>
						<li>Figma</li>
						<li>Adobe Creative Cloud</li>
						<li>Visual Studio Code</li>
						<li>Git/GitHub</li>
					</ul>
				</section>

				<section class="about-resume__group about-resume__group--languages" aria-labelledby="about-languages-title">
					<p class="about-resume__index" aria-hidden="true">03</p>
					<h3 id="about-languages-title">Idiomas</h3>
					<ul>
						<li>Español <span>· Nativo</span></li>
						<li>Inglés <span>· Intermedio</span></li>
					</ul>
				</section>

				<section class="about-resume__group about-resume__group--education" aria-labelledby="about-education-title">
					<p class="about-resume__index" aria-hidden="true">04</p>
					<h3 id="about-education-title">Educación</h3>
					<ul>
						<li>Diseño Digital <span>· Universidad Sergio Arboleda</span></li>
						<li>Formación complementaria en moda y diseño</li>
					</ul>
				</section>

				<div class="about-resume__complementary" aria-labelledby="about-complementary-title">
					<h3 id="about-complementary-title">Capacidades complementarias</h3>
					<p>Branding &amp; Identidad Visual · Diseño Editorial · Contenido Digital · Ilustración · Front-end</p>
				</div>
			</div>

			<div class="about-resume__method">
				<p>Mi forma de trabajar</p>
				<strong>Entender <span aria-hidden="true">→</span> Estructurar <span aria-hidden="true">→</span> Diseñar <span aria-hidden="true">→</span> Validar</strong>
			</div>
		</div>
	</section>

	<section class="portfolio-contents" aria-labelledby="portfolio-contents-title" data-portfolio-contents>
		<div class="container portfolio-contents__inner">
			<h2 id="portfolio-contents-title">Contenido</h2>
			<ol>
				<li><span class="portfolio-contents__number">01</span><span class="portfolio-contents__label">Diseño UX/UI</span></li>
				<li><span class="portfolio-contents__number">02</span><span class="portfolio-contents__label">Identidad visual</span></li>
				<li><span class="portfolio-contents__number">03</span><span class="portfolio-contents__label">IA generativa</span></li>
			</ol>
		</div>
	</section>

	<section class="projects" id="proyectos" aria-labelledby="projects-title">
		<div class="container projects__inner">
			<header class="projects-heading" data-projects-heading>
				<h2 id="projects-title">Proyectos</h2>
				<div class="projects-heading__category" aria-label="Categoría 01, Diseño UX/UI">
					<strong aria-hidden="true">01</strong>
					<span>Diseño UX/UI</span>
				</div>
			</header>

			<div class="project-list">
			{
				projects.map((project, index) => (
					<>
					{project.id === "sistema-visual" ? (
						<>
							<PandaChaShowcase />
							<ArepaMiaShowcase />
							<ClaraVisionShowcase />
							<header class="projects-category-break" aria-labelledby="generative-identity-title" data-projects-category>
								<div class="projects-heading__category" aria-label="Categoría 03, IA Generativa">
									<strong aria-hidden="true">03</strong>
									<h3 id="generative-identity-title">IA Generativa</h3>
								</div>
							</header>
							<GenerativeMediaGallery />
						</>
					) : (
					<article id={`proyecto-${project.id}`} class:list={["project-card", { "project-card--tailors": project.id === "tailors-shop", "project-card--regioo": project.id === "regioo", "project-card--421": project.id === "421-co" }]}>
						{project.id === "tailors-shop" ? (
							<div class="project-visual project-visual--tailors" aria-label="Prototipo interactivo de Tailor's Shop">
								<div class="project-visual--tailors__screen">
									<iframe src="./projects/tailors-shop/prototipo.html?preview=portfolio" title="Prototipo interactivo de Tailor's Shop" loading="lazy"></iframe>
								</div>
							</div>
						) : project.id === "regioo" ? (
							<div class="project-visual project-visual--regioo" aria-label="Cinco mockups de Regioo preparados para sus pantallas finales">
								<div class="project-regioo-phone project-regioo-phone--far-left"><img src="/images/projects/regioo/frame-02-foto.png" alt="Paso para subir una foto del rostro" width="440" height="956" loading="lazy" /></div>
								<div class="project-regioo-phone project-regioo-phone--left"><img src="/images/projects/regioo/frame-01-splash.png" alt="Pantalla inicial de Regioo con una invitación a crear looks únicos" width="440" height="956" loading="lazy" /></div>
								<div class="project-regioo-phone project-regioo-phone--main"><img src="/images/projects/regioo/frame-03-reggi.png" alt="Inicio de la experiencia personalizada con Reggi" width="440" height="956" loading="lazy" /></div>
								<div class="project-regioo-phone project-regioo-phone--right"><img src="/images/projects/regioo/frame-04-preferencias.png" alt="Confirmación de actualización de preferencias de estilo" width="440" height="1068" loading="lazy" /></div>
								<div class="project-regioo-phone project-regioo-phone--far-right"><img src="/images/projects/regioo/frame-05-perfil.png" alt="Perfil personal dentro de Regioo" width="456" height="969" loading="lazy" /></div>
							</div>
						) : project.id === "421-co" ? (
							<div class="project-visual project-visual--421" aria-label="Home, productos, contacto y error 404 de 421 Co. en portátil y móvil">
								<div class="project-421-row project-421-row--mobile">
									{fourTwentyOneViews.map((view) => (
										<div class="project-421-mobile"><img src={view.mobile} alt={`${view.name} de 421 Co. en celular`} width="390" height="844" loading="lazy" /></div>
									))}
								</div>
								<div class="project-421-row project-421-row--notebook">
									{fourTwentyOneViews.map((view) => (
										<div class="project-421-notebook">
											<span aria-hidden="true"></span>
											<div><img src={view.desktop} alt={`${view.name} de 421 Co. en portátil`} width="1440" height="1000" loading="lazy" /></div>
										</div>
									))}
								</div>
							</div>
						) : (
							<div class="project-visual" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></div>
						)}
						<div class="project-copy">
							{project.id !== "tailors-shop" && <p class="project-number">{String(index + 1).padStart(2, "0")}</p>}
							<h3>{project.id === "tailors-shop" ? "Tailor’s Shop" : project.data.title}</h3>
							<p class="project-discipline">{project.data.services.join(" · ")}</p>
							<p>{project.id === "tailors-shop" ? "Sistema digital para organizar diagnósticos, precios, tiempos y seguimiento en un taller de alta costura." : project.data.summary}</p>
							<a class="project-link" href={`/proyectos/${project.id}/`} target="_blank" rel="noreferrer">{project.id === "tailors-shop" ? "Ver caso de estudio →" : project.id === "regioo" || project.id === "421-co" ? "Ver proyecto →" : "Ver case study →"}</a>
						</div>
					</article>
					)}
					{project.id === "421-co" && (
						<header class="projects-category-break" aria-labelledby="visual-identity-title" data-projects-category>
							<div class="projects-heading__category" aria-label="Categoría 02, Identidad visual">
								<strong aria-hidden="true">02</strong>
								<h3 id="visual-identity-title">Identidad visual</h3>
							</div>
						</header>
					)}
					</>
				))
			}
			</div>
		</div>
	</section>

	<section class="profile" aria-labelledby="profile-title" data-closing-profile>
		<div class="container profile-grid">
			<header class="profile-heading">
				<p class="eyebrow">Enfoque</p>
				<h2 id="profile-title">
					<span>Pienso como diseñadora</span>
					<span>y construyo con mentalidad</span>
					<span>de producto.</span>
				</h2>
			</header>
			<div class="profile-copy">
				<p class="profile-copy__intro">
					Trabajo entre investigación, sistemas visuales y código para que cada decisión tenga una razón y cada
					detalle contribuya a la experiencia completa.
				</p>
				<div class="profile-capabilities" aria-labelledby="capabilities-title">
					<p class="eyebrow" id="capabilities-title">Capacidades</p>
					<ul>
						<li><span>01</span><strong>Estrategia y experiencia de usuario</strong></li>
						<li><span>02</span><strong>Interfaces y sistemas de diseño</strong></li>
						<li><span>03</span><strong>Identidad y dirección visual</strong></li>
						<li><span>04</span><strong>Prototipos y front-end</strong></li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section class="contact" id="contacto" aria-labelledby="contact-title" data-contact-section>
		<div class="container contact__inner">
			<header class="contact__heading">
				<p class="eyebrow">Hablemos</p>
			</header>
			<h2 id="contact-title" aria-label="Contacto"><span>Conta</span><span>cto</span></h2>
			<img
				class="contact__portrait"
				src="/images/hero/juanita-personaje-original.png"
				width="1024"
				height="1536"
				alt="Ilustración de Juanita Rodríguez"
				loading="lazy"
				decoding="async"
			/>
			<address class="contact__links">
				<a href="mailto:juanitarodrigueza00@gmail.com"><span>Correo</span>juanitarodrigueza00@gmail.com</a>
				<a href="https://www.linkedin.com/in/juanita-rodriguez-araujo" target="_blank" rel="noreferrer"><span>LinkedIn</span>juanita-rodriguez-araujo</a>
				<a href="tel:+573108766858"><span>Teléfono o WhatsApp</span>+57 310 876 6858</a>
			</address>
		</div>
	</section>
</BaseLayout>

<style>
	.about-resume {
		--about-burgundy: #600822;
		--about-dusty-pink: #d58a9c;
		--about-pastel-pink: #deadb9;
		--about-soft-white: #fdfdfe;
		padding-block: clamp(3rem, 4.5vw, 4.25rem);
		overflow: hidden;
		background: var(--about-soft-white);
		color: var(--about-burgundy);
	}

	.about-resume__inner {
		display: grid;
		gap: clamp(1.25rem, 2vw, 1.75rem);
	}

	.about-resume__hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: end;
		min-height: 33rem;
		border-bottom: 1px solid rgb(96 8 34 / 0.24);
	}

	.about-resume__identity {
		position: relative;
		z-index: 2;
		padding-block: 0 1.75rem;
	}

	.about-resume__eyebrow,
	.about-resume__group h3,
	.about-resume__method p {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.about-resume__eyebrow {
		margin-block-end: clamp(1rem, 1.5vw, 1.4rem);
		color: var(--about-dusty-pink);
	}

	.about-resume h2 {
		display: grid;
		gap: 0.22em;
		max-width: 8.8ch;
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(3.65rem, 11vw, 7.75rem);
		font-weight: 900;
		line-height: 0.82;
		letter-spacing: -0.075em;
		text-transform: uppercase;
	}

	.about-resume h2 span {
		display: block;
	}

	.about-resume__role {
		margin: 1.3rem 0 0;
		font-size: clamp(1rem, 1.35vw, 1.2rem);
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.about-resume__role span,
	.about-resume__group li span {
		color: var(--about-dusty-pink);
	}

	.about-resume__statement {
		max-width: 59ch;
		margin: 0.7rem 0 0;
		color: #764052;
		font-size: clamp(0.94rem, 1.05vw, 1.03rem);
		line-height: 1.45;
	}

	@property --orb-x-1 {
		syntax: "<percentage>";
		inherits: false;
		initial-value: 24%;
	}

	@property --orb-y-1 {
		syntax: "<percentage>";
		inherits: false;
		initial-value: 22%;
	}

	@property --orb-x-2 {
		syntax: "<percentage>";
		inherits: false;
		initial-value: 76%;
	}

	@property --orb-y-2 {
		syntax: "<percentage>";
		inherits: false;
		initial-value: 30%;
	}

	@property --orb-x-3 {
		syntax: "<percentage>";
		inherits: false;
		initial-value: 68%;
	}

	@property --orb-y-3 {
		syntax: "<percentage>";
		inherits: false;
		initial-value: 78%;
	}

	@property --orb-x-4 {
		syntax: "<percentage>";
		inherits: false;
		initial-value: 22%;
	}

	@property --orb-y-4 {
		syntax: "<percentage>";
		inherits: false;
		initial-value: 74%;
	}

	.about-resume__portrait {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 23rem;
		overflow: visible;
		isolation: isolate;
	}

	.about-resume__clip-def {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}

	.about-resume__halo {
		--orb-pointer-x: 0px;
		--orb-pointer-y: 0px;
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 0;
		width: min(88vw, 25rem);
		aspect-ratio: 1;
		border-radius: 44% 56% 61% 39% / 52% 43% 57% 48%;
		background-image:
			radial-gradient(
				circle at calc(var(--orb-x-1) + var(--orb-pointer-x)) calc(var(--orb-y-1) + var(--orb-pointer-y)),
				rgb(255 255 255 / 0.82) 0 8%,
				rgb(255 255 255 / 0.22) 27%,
				transparent 52%
			),
			radial-gradient(
				circle at calc(var(--orb-x-2) + var(--orb-pointer-x)) calc(var(--orb-y-2) + var(--orb-pointer-y)),
				rgb(222 173 185 / 0.72) 0 12%,
				rgb(222 173 185 / 0.28) 38%,
				transparent 68%
			),
			radial-gradient(
				circle at calc(var(--orb-x-3) - var(--orb-pointer-x)) calc(var(--orb-y-3) - var(--orb-pointer-y)),
				rgb(213 138 156 / 0.5) 0 9%,
				rgb(213 138 156 / 0.16) 35%,
				transparent 64%
			),
			radial-gradient(
				circle at calc(var(--orb-x-4) - var(--orb-pointer-x)) calc(var(--orb-y-4) - var(--orb-pointer-y)),
				rgb(96 8 34 / 0.16) 0 6%,
				rgb(96 8 34 / 0.06) 29%,
				transparent 58%
			);
		filter: blur(1.35rem) saturate(112%);
		opacity: 0.7;
		transform: translate(-50%, -50%);
		will-change: border-radius, transform;
	}

	.about-resume__halo::before,
	.about-resume__halo::after {
		position: absolute;
		border-radius: inherit;
		content: "";
		pointer-events: none;
	}

	.about-resume__halo::before {
		inset: 8% 3% 18% 17%;
		background: linear-gradient(135deg, rgb(255 255 255 / 0.58), rgb(222 173 185 / 0.1));
		filter: blur(1.25rem);
		mix-blend-mode: screen;
	}

	.about-resume__halo::after {
		inset: 54% -7% -4% 42%;
		background: rgb(213 138 156 / 0.26);
		filter: blur(1.7rem);
		opacity: 0.62;
	}

	.about-resume__photo-shell {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		width: min(72vw, 19rem);
		aspect-ratio: 278.5 / 303;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.38);
		box-shadow:
			0 1.9rem 4.8rem rgb(96 8 34 / 0.12),
			0 0 0 1px rgb(255 255 255 / 0.34);
		backdrop-filter: blur(0.9rem) saturate(108%);
		-webkit-clip-path: url("#about-portrait-clip");
		clip-path: url("#about-portrait-clip");
		transform: translate(-50%, -50%);
		isolation: isolate;
	}

	.about-resume__photo-shell::after {
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: inherit;
		background:
			linear-gradient(135deg, rgb(255 255 255 / 0.22) 0 16%, transparent 38%),
			radial-gradient(circle at 78% 82%, rgb(213 138 156 / 0.08), transparent 38%);
		content: "";
		pointer-events: none;
	}

	.about-resume__photo-shell img {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: inherit;
		object-fit: cover;
		object-position: 50% 0%;
	}

	@keyframes about-orb-mesh {
		0%,
		100% {
			--orb-x-1: 24%;
			--orb-y-1: 22%;
			--orb-x-2: 76%;
			--orb-y-2: 30%;
			--orb-x-3: 68%;
			--orb-y-3: 78%;
			--orb-x-4: 22%;
			--orb-y-4: 74%;
			transform: translate(-50%, -50%) rotate(-2deg) scale(0.98);
		}

		36% {
			--orb-x-1: 66%;
			--orb-y-1: 17%;
			--orb-x-2: 32%;
			--orb-y-2: 60%;
			--orb-x-3: 82%;
			--orb-y-3: 50%;
			--orb-x-4: 43%;
			--orb-y-4: 86%;
			transform: translate(calc(-50% + 0.55rem), calc(-50% - 0.4rem)) rotate(3deg) scale(1.035);
		}

		68% {
			--orb-x-1: 40%;
			--orb-y-1: 68%;
			--orb-x-2: 78%;
			--orb-y-2: 72%;
			--orb-x-3: 28%;
			--orb-y-3: 38%;
			--orb-x-4: 64%;
			--orb-y-4: 22%;
			transform: translate(calc(-50% - 0.4rem), calc(-50% + 0.45rem)) rotate(-1deg) scale(1.01);
		}
	}

	@keyframes about-photo-float {
		0%,
		100% { transform: translate(-50%, -50%); }
		50% { transform: translate(-50%, calc(-50% - 0.35rem)); }
	}

	@keyframes about-orb-shape {
		0%,
		100% {
			border-radius: 50% 48% 52% 49% / 49% 52% 48% 51%;
		}

		34% {
			border-radius: 52% 48% 49% 51% / 48% 51% 49% 52%;
		}

		67% {
			border-radius: 48% 52% 51% 49% / 52% 49% 51% 48%;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.about-resume__halo {
