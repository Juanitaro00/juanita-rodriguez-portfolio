<script>
	const aboutOrb = document.querySelector<HTMLElement>("[data-about-orb]");
	const aboutPortrait = aboutOrb?.closest<HTMLElement>(".about-resume__portrait");
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	const portfolioContents = document.querySelector<HTMLElement>("[data-portfolio-contents]");
	const projectCategoryHeadings = document.querySelectorAll<HTMLElement>("[data-projects-heading], [data-projects-category]");
	const closingSections = document.querySelectorAll<HTMLElement>("[data-closing-profile], [data-contact-section]");

	if (closingSections.length && !reducedMotion.matches) {
		const closingObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				});
			},
			{ threshold: 0.18 },
		);

		closingSections.forEach((section) => {
			section.classList.add("is-motion-ready");
			closingObserver.observe(section);
		});
	}

	if (portfolioContents && !reducedMotion.matches) {
		portfolioContents.classList.add("is-motion-ready");
		let contentsResetTimer = 0;
		const contentsObserver = new IntersectionObserver(
			(entries) => {
				const entry = entries[0];
				if (!entry) return;

				window.clearTimeout(contentsResetTimer);

				if (!entry.isIntersecting) {
					portfolioContents.classList.remove("is-visible");
					portfolioContents.classList.add("is-motion-ready");
					return;
				}

				portfolioContents.classList.add("is-motion-ready");
				portfolioContents.classList.remove("is-visible");
				window.requestAnimationFrame(() => {
					window.requestAnimationFrame(() => portfolioContents.classList.add("is-visible"));
				});
				contentsResetTimer = window.setTimeout(
					() => portfolioContents.classList.remove("is-motion-ready", "is-visible"),
					2400,
				);
			},
			{ threshold: 0.01 },
		);
		contentsObserver.observe(portfolioContents);
	}

	if (projectCategoryHeadings.length && !reducedMotion.matches) {
		projectCategoryHeadings.forEach((heading) => {
			heading.classList.add("is-motion-ready");
			let resetTimer = 0;
			const observer = new IntersectionObserver(
				(entries) => {
					const entry = entries[0];
					if (!entry) return;

					window.clearTimeout(resetTimer);

					if (!entry.isIntersecting) {
						heading.classList.remove("is-visible");
						heading.classList.add("is-motion-ready");
						return;
					}

					heading.classList.add("is-motion-ready");
					heading.classList.remove("is-visible");
					window.requestAnimationFrame(() => {
						window.requestAnimationFrame(() => heading.classList.add("is-visible"));
					});
					resetTimer = window.setTimeout(
						() => heading.classList.remove("is-motion-ready", "is-visible"),
						1600,
					);
				},
				{ threshold: 0.01 },
			);
			observer.observe(heading);
		});
	}

	if (aboutOrb && aboutPortrait) {
		let currentX = 0;
		let currentY = 0;
		let targetX = 0;
		let targetY = 0;
		let animationFrame = 0;

		const renderPointerResponse = () => {
			currentX += (targetX - currentX) * 0.085;
			currentY += (targetY - currentY) * 0.085;

			aboutOrb.style.setProperty("--orb-pointer-x", `${currentX.toFixed(2)}px`);
			aboutOrb.style.setProperty("--orb-pointer-y", `${currentY.toFixed(2)}px`);

			if (Math.abs(targetX - currentX) > 0.02 || Math.abs(targetY - currentY) > 0.02) {
				animationFrame = window.requestAnimationFrame(renderPointerResponse);
			} else {
				animationFrame = 0;
			}
		};

		const queuePointerResponse = () => {
			if (!animationFrame) animationFrame = window.requestAnimationFrame(renderPointerResponse);
		};

		aboutPortrait.addEventListener(
			"pointermove",
			(event) => {
				if (reducedMotion.matches) return;

				const bounds = aboutOrb.getBoundingClientRect();
				const normalizedX = Math.max(
					-1,
					Math.min(1, (event.clientX - (bounds.left + bounds.width / 2)) / (bounds.width / 2)),
				);
				const normalizedY = Math.max(
					-1,
					Math.min(1, (event.clientY - (bounds.top + bounds.height / 2)) / (bounds.height / 2)),
				);

				targetX = normalizedX * 16;
				targetY = normalizedY * 13;
				queuePointerResponse();
			},
			{ passive: true },
		);

		aboutPortrait.addEventListener("pointerleave", () => {
			targetX = 0;
			targetY = 0;
			queuePointerResponse();
		});
	}

</script>
